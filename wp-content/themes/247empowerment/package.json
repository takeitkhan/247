    "license": "ISC",
    "devDependencies": {
        "sass": "^1.78.0"
    },
    "dependencies": {
        "bootstrap": "^5.3.3",
        "font-awesome": "^6.5.0",
        "toastify-js": "^1.13.0"
    }
}