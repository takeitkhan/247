{
    "name": "247empowerment-theme",
    "version": "1.0.0",
    "description": "WordPress theme 247empowerment with SCSS compilation",
    "main": "index.js",
    "scripts": {
        "build-css": "sass assets/scss/custom-bootstrap.scss assets/css/output.css --style=compressed",
        "watch-css": "sass --watch assets/scss/custom-bootstrap.scss:assets/css/output.css --style=compressed"
    },
