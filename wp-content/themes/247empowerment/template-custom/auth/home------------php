<script>
document.addEventListener('DOMContentLoaded', function () {
    const widget = document.getElementById('support-chat-widget');
    const toggle = document.getElementById('support-chat-toggle');
    const panel = document.getElementById('support-chat-panel');
    const closeButton = document.getElementById('support-chat-close');
    const questionsWrap = document.getElementById('support-chat-questions');
    const answerWrap = document.getElementById('support-chat-answer');
    const answerQuestion = document.getElementById('support-chat-answer-question');
    const answerText = document.getElementById('support-chat-answer-text');
    const resetButton = document.getElementById('support-chat-reset');

    if (!widget || !toggle || !panel) {
        return;
    }

    function openPanel() {
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        widget.classList.add('is-open');
    }

    function closePanel() {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        widget.classList.remove('is-open');
    }

    function showQuestions() {
        questionsWrap.hidden = false;
        answerWrap.hidden = true;
        answerQuestion.textContent = '';
        answerText.textContent = '';
    }

    function showAnswer(question, answer) {
        answerQuestion.textContent = question;
        answerText.textContent = answer;
        questionsWrap.hidden = true;
        answerWrap.hidden = false;
    }

    toggle.addEventListener('click', function () {
        if (panel.hidden) {
            openPanel();
            return;
        }

        closePanel();
    });

    if (closeButton) {
        closeButton.addEventListener('click', closePanel);
    }

    if (resetButton) {
        resetButton.addEventListener('click', showQuestions);
    }

    questionsWrap.querySelectorAll('.support-chat-question').forEach(function (button) {
        button.addEventListener('click', function () {
            showAnswer(button.dataset.question || '', button.dataset.answer || '');
        });
    });

    document.addEventListener('click', function (event) {
        if (!widget.classList.contains('is-open')) {
            return;
        }

        if (widget.contains(event.target)) {
            return;
        }

        closePanel();
    });
});
</script>
